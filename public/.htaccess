# ============================================
# .htaccess for Lume Art Studio
# SEO Optimizations for React SPA
# Domain: https://lumeartstudio.com/
# ============================================

# ============================================
# REWRITE RULES - Essential for SPA
# ============================================
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Force HTTPS
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Remove trailing slashes
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [R=301,L]

    # React Router SPA
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} !^/api/
    RewriteCond %{REQUEST_URI} !^/sitemap\.xml$ [NC]
    RewriteCond %{REQUEST_URI} !^/robots\.txt$ [NC]
    RewriteRule . /index.html [L]
</IfModule>

# ============================================
# COMPRESSION (GZIP)
# ============================================
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css
    AddOutputFilterByType DEFLATE text/javascript application/javascript
    AddOutputFilterByType DEFLATE application/json application/xml
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE font/ttf font/otf
</IfModule>

# ============================================
# BROWSER CACHING (NON-IMAGE FILES)
# ============================================
<IfModule mod_expires.c>
    ExpiresActive On

    # Fonts & static assets
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/otf "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"

    ExpiresByType text/css "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"

    # Dynamic content
    ExpiresByType text/html "access plus 1 hour"
    ExpiresByType application/json "access plus 0 seconds"

    ExpiresDefault "access plus 1 month"
</IfModule>

# ============================================
# MOBILE vs DESKTOP IMAGE CACHING
# ============================================
<IfModule mod_headers.c>

    # Required when using UA-based logic
    Header append Vary "User-Agent"

    # 📱 Mobile devices – 30 days
    <If "%{HTTP_USER_AGENT} =~ /(Android|iPhone|iPad|iPod|Mobile|Opera Mini|IEMobile)/i">
        <FilesMatch "\.(jpg|jpeg|png|gif|webp|avif|svg)$">
            Header set Cache-Control "public, max-age=2592000"
        </FilesMatch>
    </If>

    # 🖥 Desktop – 1 year
    <Else>
        <FilesMatch "\.(jpg|jpeg|png|gif|webp|avif|svg)$">
            Header set Cache-Control "public, max-age=31536000, immutable"
        </FilesMatch>
    </Else>

</IfModule>

# ============================================
# SECURITY HEADERS
# ============================================
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ============================================
# SEO FILES
# ============================================
<FilesMatch "^(sitemap\.xml|robots\.txt)$">
    <IfModule mod_headers.c>
        Header set Cache-Control "max-age=3600, public"
    </IfModule>
</FilesMatch>

# ============================================
# ERROR HANDLING (SPA)
# ============================================
ErrorDocument 404 /index.html
ErrorDocument 500 /index.html

# ============================================
# SECURITY
# ============================================
Options -Indexes

<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<FilesMatch "(^#.*#|\.(bak|conf|config|dist|log|sql|sh|orig|psd)|~)$">
    Require all denied
</FilesMatch>

# ============================================
# ENCODING
# ============================================
AddDefaultCharset UTF-8
<IfModule mod_mime.c>
    AddCharset UTF-8 .html .css .js .xml .json
</IfModule>

# ============================================
# CACHE OPTIMIZATION
# ============================================
<IfModule mod_headers.c>
    Header unset ETag
</IfModule>
FileETag None
