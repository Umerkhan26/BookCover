# ============================================
# .htaccess for Lume Art Studio
# SEO Optimizations for React SPA
# Domain: https://lumeartstudio.com/
# ============================================

# ============================================
# REWRITE RULES - Essential for SPA
# ============================================
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Force HTTPS (Essential for SEO and Security)
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Optional: Force WWW (Uncomment if you want www.lumeartstudio.com)
    # RewriteCond %{HTTP_HOST} !^www\. [NC]
    # RewriteRule ^(.*)$ https://www.%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Remove trailing slashes for cleaner URLs (SEO friendly)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [R=301,L]

    # React Router SPA - Redirect all non-file requests to index.html
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} !^/api/
    RewriteCond %{REQUEST_URI} !^/sitemap\.xml$ [NC]
    RewriteCond %{REQUEST_URI} !^/robots\.txt$ [NC]
    RewriteRule . /index.html [L]
</IfModule>

# ============================================
# COMPRESSION (GZIP) - Essential for Performance
# ============================================
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE font/opentype
    AddOutputFilterByType DEFLATE font/otf
    AddOutputFilterByType DEFLATE font/ttf
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE image/x-icon
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/xml
</IfModule>

# ============================================
# BROWSER CACHING - Essential for Performance & SEO
# ============================================
<IfModule mod_expires.c>
    ExpiresActive On

    # Static assets - 1 year (Vite adds hash to filenames)
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/otf "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"

    # Dynamic content - shorter cache
    ExpiresByType text/html "access plus 1 hour"
    ExpiresByType application/xml "access plus 1 hour"
    ExpiresByType text/xml "access plus 1 hour"
    ExpiresByType text/plain "access plus 1 hour"
    ExpiresByType application/json "access plus 0 seconds"

    ExpiresDefault "access plus 1 month"
</IfModule>

# Fallback caching if mod_expires is not available
<IfModule !mod_expires.c>
    <IfModule mod_headers.c>
        <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|ico|ttf|otf|woff|woff2|css|js)$">
            Header set Cache-Control "max-age=31536000, public, immutable"
        </FilesMatch>
        <FilesMatch "\.(html|htm)$">
            Header set Cache-Control "max-age=3600, public, must-revalidate"
        </FilesMatch>
    </IfModule>
</IfModule>

# ============================================
# SECURITY HEADERS - Essential for Security & SEO
# ============================================
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"

    # Optional: Content Security Policy (Uncomment and customize if needed)
    # Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:;"

    # Optional: Permissions Policy (Uncomment if you need to restrict features)
    # Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# ============================================
# SEO FILES - Essential for Search Engines
# ============================================
<FilesMatch "^(sitemap\.xml|robots\.txt)$">
    <IfModule mod_headers.c>
        Header set Cache-Control "max-age=3600, public"
    </IfModule>
</FilesMatch>

# ============================================
# ERROR HANDLING - Essential for SPA
# ============================================
ErrorDocument 404 /index.html
ErrorDocument 500 /index.html

# ============================================
# SECURITY - Essential
# ============================================
Options -Indexes

<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<FilesMatch "(^#.*#|\.(bak|conf|config|dist|fla|in[ci]|log|orig|psd|sh|sql|sw[op])|~)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# ============================================
# ENCODING - Essential
# ============================================
AddDefaultCharset UTF-8
<IfModule mod_mime.c>
    AddCharset UTF-8 .html .css .js .xml .json
</IfModule>

# ============================================
# CACHE OPTIMIZATION - Essential
# ============================================
<IfModule mod_headers.c>
    Header unset ETag
</IfModule>
FileETag None
